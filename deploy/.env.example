# ============================================================================
# ARGOS / IRIS — variables de la pile de déploiement (copier en .env)
# Le fichier .env n'est JAMAIS versionné. Générer les secrets, ne pas les
# choisir : voir README.md (« Secrets »).
# ============================================================================

# Port HTTP publié par le reverse proxy sur la station.
HTTP_PORT=80
# URL sous laquelle les postes joignent la station (pour les métadonnées de tuiles).
PUBLIC_URL=http://localhost

# --- HTTPS : exposer la station au réseau ou à Internet, sans relais tiers ---
# Rien d'activé = HTTP seul sur HTTP_PORT. Pour activer, décommenter UNE ligne
# COMPOSE_FILE, puis `docker compose up -d` (README § 11) :
#   compose.https.yml       certificat auto-signé de la station — avertissement
#                           du navigateur à accepter une fois ; suffit au réseau
#                           local et rend possible le partage de position des
#                           téléphones (qui exige HTTPS) ;
#   compose.letsencrypt.yml certificat public reconnu — DOMAIN et ACME_EMAIL
#                           requis, ports 443 et 80 redirigés vers la station.
COMPOSE_PATH_SEPARATOR=:
#COMPOSE_FILE=docker-compose.yml:compose.https.yml
#COMPOSE_FILE=docker-compose.yml:compose.letsencrypt.yml
HTTPS_PORT=443
DOMAIN=
ACME_EMAIL=

# --- Fond de carte (ADR 0014) — figé dans l'image web à la construction -------
# VERSION RIF (sans Internet) : la station sert elle-même tout ce que la carte
# affiche — imagerie, relief 3D, plan et toponymes vectoriels du Maroc
# (données OpenStreetMap, sans frontière contestée : le Royaume est entier),
# polices latin + arabe — depuis le volume iris_argos_tiles, importé du paquet
# (deploy	iles-data, scripts	iles-import.ps1) ou rempli une fois avec
# Internet (README § 4). L'expérience est celle du mode en ligne (ADR 0023).
# external  = la carte du mode développement : imagerie Esri/Maxar, plan et
#             toponymes OpenFreeMap, relief AWS appelés par le navigateur —
#             Internet requis sur chaque poste, rien à préparer.
# sovereign = tuiles hors ligne servies par la station : COMPOSE_PROFILES=sovereign
#             lance le serveur de tuiles.
# Changer de mode = reconstruire l'image web (docker compose up -d --build web)
# ou charger un paquet construit dans ce mode.
MAP_TILES=sovereign
COMPOSE_PROFILES=sovereign

# --- Base de données ---------------------------------------------------------
POSTGRES_DB=argos
POSTGRES_USER=argos
POSTGRES_PASSWORD=CHANGER-MOI-secret-long-aleatoire

# --- API ----------------------------------------------------------------------
# dev = comptes gérés dans l'application (matricule + mot de passe) — le mode
# complet aujourd'hui. keycloak = OIDC (KEYCLOAK_ISSUER/AUDIENCE à renseigner).
AUTH_MODE=dev
# Secret de signature des jetons de session (HS256). 48 caractères aléatoires au moins.
AUTH_DEV_SECRET=CHANGER-MOI-secret-long-aleatoire
# postgres = audit, drapeaux et bons de travail en base ; memory = tout en instantané JSON.
DB_DRIVER=postgres
# Origines autorisées à appeler l'API HORS de la page (outils) — la page elle-même est same-origin.
CORS_ORIGINS=http://localhost
# Mode de la station (ADR 0016) : operational = en service, rien de simulé ;
# exercise = station vide, l'OPCOM et les cellules créent unités et ressources ;
# demo = jeu de démonstration reconstruit au démarrage. Se change aussi depuis
# Paramètres › Profil de données (le réglage persisté prime, l'API redémarre).
# Quitter la démonstration garde ce que les opérateurs ont créé, les comptes, la base.
APP_MODE=operational
# Suivi aérien : exercise (noria simulée, sans réseau — profil demo seulement) ou opensky (Internet requis).
AVIATION_FEED=exercise
# Visibilité des incidents : all (défaut — tout incident se voit de tous les rôles) ou scoped (cantonnement par portée, doctrine V-1).
INCIDENTS_VISIBILITY=all
# Visibilité des unités et du terrain : all (défaut — tout le monde voit ce qui se passe sur la carte, ADR 0027) ou scoped (cantonnement par portée, ADR 0020).
UNITS_VISIBILITY=all
# Crues (Google Flood Forecasting API / Flood Hub) : clé Google Cloud, vide = flux indisponible (ADR 0010).
FLOOD_API_KEY=

# --- Routage (Valhalla) -------------------------------------------------------
# Laisser vide pour une station SANS Internet : l'extrait OSM doit alors avoir
# été déposé dans le volume (docker compose run --rm tiles-fetch pbf).
# Vide (RIF) : Valhalla lit l'extrait OSM déposé par `tiles-fetch pbf` (ou par
# l'archive des tuiles) ; avec Internet, on peut lui donner l'URL Geofabrik :
# https://download.geofabrik.de/africa/morocco-latest.osm.pbf
VALHALLA_TILE_URLS=
VALHALLA_THREADS=2

# --- Provisionnement des tuiles hors ligne (mode sovereign, profil tiles-build) ---
# Imagerie : gabarit XYZ ({z} {x} {y}, dans l'ordre propre à la source). Le
# gabarit ci-dessous est celui de l'imagerie affichée en mode en ligne (Esri
# World Imagery, Maxar) ; l'aspirer en masse relève des conditions d'utilisation
# d'Esri — le droit de le faire hors ligne (licence ArcGIS, export de paquets
# de tuiles) est à la charge de l'organisme (infra/geo/README.md § 2). Toute
# autre source XYZ (mosaïque institutionnelle, Sentinel-2) se met à la place.
# Vide = pas d'imagerie ; le fond « plan » (OpenStreetMap) suffit à la carte.
SAT_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# Altitude (relief 3D) : tuiles terrarium ouvertes (AWS Terrain Tiles).
DEM_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
