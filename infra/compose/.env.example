# ARGOS — variables d'environnement de la pile (copier en .env, ne pas committer les secrets)

# Base de données
POSTGRES_DB=argos
POSTGRES_USER=argos
POSTGRES_PASSWORD=change-me-strong

# Keycloak (console d'admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-strong

# MinIO
MINIO_ROOT_USER=argos
MINIO_ROOT_PASSWORD=change-me-strong

# --- API (apps/api) -------------------------------------------------------
# AUTH_MODE=keycloak en production ; dev en local pour tester sans Keycloak.
AUTH_MODE=keycloak
KEYCLOAK_ISSUER=http://localhost:8080/realms/argos
KEYCLOAK_AUDIENCE=argos-api
# Secret HS256 du mode dev uniquement (jamais utilisé en production) :
AUTH_DEV_SECRET=argos-dev-secret-change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
PORT=4000
