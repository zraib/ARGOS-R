# ARGOS API — copier en .env
NODE_ENV=development
PORT=3005
# dev = jetons HS256 locaux (sans Keycloak) ; keycloak = OIDC RS256/JWKS
AUTH_MODE=dev
AUTH_DEV_SECRET=argos-dev-secret-change-me
KEYCLOAK_ISSUER=http://localhost:8080/realms/argos
KEYCLOAK_AUDIENCE=argos-api
CORS_ORIGINS=http://localhost:3004,http://127.0.0.1:3004,http://localhost:3100

# --- suivi aérien (module aviation, voir docs/adr/0004) ---
# opensky = flux ADS-B réel ; exercise = noria simulée, sans réseau
AVIATION_FEED=opensky
# Cache du flux, en millisecondes (garder SOUS la cadence de publication ~10 s)
AVIATION_FEED_TTL_MS=5000
# Identifiants OpenSky FACULTATIFS (quota élargi). Ne JAMAIS versionner.
# Crues — Google Flood Forecasting API (Flood Hub), clé d'un projet Google Cloud
# (ADR 0010). Sans clé, la carte dit « flux des crues indisponible » ; le
# simulateur d'inondation, lui, reste entièrement local.
# FLOOD_API_KEY=

# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=
# Visibilité des unités et du terrain : all (défaut — tout le monde voit ce qui se passe sur la carte, ADR 0027) ou scoped (ADR 0020).
UNITS_VISIBILITY=all
