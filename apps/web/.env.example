# Copier en .env.local et adapter. Toutes ces variables sont exposées au
# navigateur (préfixe NEXT_PUBLIC_) : n'y mettre aucun secret.

# API ARGOS (apps/api)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3005

# Fond de carte (voir docs/adr/0006-courtier-de-flux-externes.md)
#   sovereign = tuiles auto-hébergées (martin) — IMPOSÉ en production
#   external  = fournisseurs publics (Esri/OSM/AWS) — DÉVELOPPEMENT SEULEMENT.
#               L'interface affiche alors un bandeau : le fond de carte n'est
#               pas souverain et le profil d'activité fuit vers ces tiers.
NEXT_PUBLIC_MAP_TILES=external
# URL des tuiles auto-hébergées, requise en mode sovereign. Tant que le
# pipeline infra/geo n'alimente pas martin, la laisser vide donne une carte
# SANS FOND — voulu : jamais de repli silencieux vers un fournisseur étranger.
NEXT_PUBLIC_TILES_URL=

# Moteur d'itinéraire : le navigateur ne le joint plus — l'API calcule les
# itinéraires (ROUTING_URL côté API, ADR 0039).
